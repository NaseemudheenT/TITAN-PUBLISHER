# TITAN PUBLISHER environment reference. Copy to .env.local and fill in.
# Never commit real values. Variables marked (required) must be set in production.

# Public base URL of the deployed app, no trailing slash. Used for OAuth redirect URIs. (required)
APP_URL=https://your-domain.example

# Postgres connection string. (required)
DATABASE_URL=postgres://user:password@host:5432/titan

# 32 random bytes, base64. Generate: openssl rand -base64 32  (required)
TOKEN_ENCRYPTION_KEY=

# Secret for the scheduler/worker tick endpoint (min 16 chars). Generate: openssl rand -hex 24  (required)
CRON_SECRET=

# Durable media storage (Vercel Blob). (required in production)
BLOB_READ_WRITE_TOKEN=
# Local development only: directory used instead of Vercel Blob when BLOB_READ_WRITE_TOKEN is unset.
LOCAL_STORAGE_DIR=.local-storage

# AI provider. Use AI_PROVIDER=mock for local development without a key.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=

# Google OAuth client (YouTube Data API v3).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta app (Instagram and Facebook publishing).
META_APP_ID=
META_APP_SECRET=

# Optional limits.
MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_SECONDS=3600
WORKER_CONCURRENCY=3
